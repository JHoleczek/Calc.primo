# Kalkulator na razie dostępny tylko z linku: wyszukiwarki go nie indeksują.
# (Plik działa na hostingu Apache/LiteSpeed, np. cyber_folks.)
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"

  # Strona główna kalkulatora zawsze świeża – po każdej aktualizacji przeglądarka od razu dostaje nową wersję.
  # Pliki w assets/ mają w nazwie skrót zawartości, więc mogą być trzymane w pamięci podręcznej długo.
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
Options -Indexes
DirectoryIndex index.html
